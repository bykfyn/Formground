# Copy this file to .env in the same folder, then fill in real values there.
# .env is already gitignored - never commit real keys.

# Required: at least one of these, matching whichever LLM_PROVIDER you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: only set these to override the defaults in query_engine.py.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
